DATABASE_URL=postgresql+psycopg://etl_builder:change-me@postgres:5432/etl_builder
POSTGRES_PASSWORD=replace-with-a-stable-url-safe-password
APP_TIMEZONE=Asia/Kolkata
PASSWORD_PEPPER=replace-with-a-stable-random-secret
APP_SECRET_KEY=replace-with-a-different-stable-random-secret
SESSION_TTL_DAYS=7
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_MINUTES=15
APP_CORS_ORIGINS=http://localhost:8080
APP_CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_HEADERS=Authorization,Content-Type
SCHEDULER_TRIGGER_WORKERS=2
SCHEDULER_RUN_WORKERS=2
SCHEDULE_JOB_MAX_INSTANCES=1
SCHEDULE_MISFIRE_GRACE_SECONDS=86400
SCHEDULE_STALE_RUNNING_MINUTES=1440
SCHEDULE_RUN_MAX_ATTEMPTS=3
SCHEDULE_WORKER_POLL_SECONDS=2
RUN_EMBEDDED_SCHEDULER=true
LOG_LEVEL=INFO
SOURCE_DB_CONNECT_TIMEOUT_SECONDS=10
SOURCE_DB_QUERY_TIMEOUT_SECONDS=300
PREVIEW_SQL_LIMIT=100
ALLOW_UNSAFE_SQL=false
REDSHIFT_SSL=true
REDSHIFT_SSLMODE=verify-full
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/Sheet_Service.json
GOOGLE_SHEETS_MAX_RETRIES=3
SQL_ASSISTANT_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_SQL_MODEL=sqlcoder:7b
SQL_ASSISTANT_TIMEOUT_SECONDS=180
CATALOG_MAX_TABLES=250
CATALOG_MAX_COLUMNS_PER_TABLE=250
SQL_ASSISTANT_SCHEMA_TABLE_LIMIT=12
VITE_API_BASE_URL=
VITE_WS_BASE_URL=
VITE_APP_TIMEZONE=Asia/Kolkata
